# Copy to .env and edit. Real environment variables override these.

# Folder that contains countries/. Leave commented to use <repo>/data.
# GRANT_DATA_ROOT=C:/path/to/grant-data

# Where collectors write snapshots and where the tools read them.
# GRANT_STATE_DIR=./state

# Which announcement collectors run when calling collectors/run_all.py.
# Available: arc, california, canada, state_dept, all, none. A comma list
# enables a subset.
# GRANT_COLLECTORS=arc,california

# DaedalMap geometry tools for place to loc_id lookups.
GEOMETRY_MCP_URL=https://app.daedalmap.com/mcp

# Server address.
# GRANT_MCP_HOST=127.0.0.1
# GRANT_MCP_PORT=7020

# Comma-separated bearer tokens. Leave empty for local use.
# GRANT_MCP_ACCESS_TOKENS=

# Query memory cap. 1GB by default for a local run; country-wide USA queries
# need more than 256MB.
# GRANT_DUCKDB_MEMORY_LIMIT=1GB
